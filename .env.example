# Credenciais compartilhadas pelo PostgreSQL e pelo backend
POSTGRES_DB=gestor
POSTGRES_USER=gestor
POSTGRES_PASSWORD=gestor

# Porta do PostgreSQL usada pelo backend fora do Docker Compose
POSTGRES_PORT=5432

# Porta pública da stack Docker e destino do proxy de desenvolvimento
FRONTEND_PORT=80
API_TARGET=http://localhost:8080
